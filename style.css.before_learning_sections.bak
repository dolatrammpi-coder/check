*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:#182235;background:#f7f9fc;line-height:1.6}
a{text-decoration:none;color:inherit}
.container{width:min(1160px,calc(100% - 32px));margin:auto}

.site-header{height:74px;background:rgba(255,255,255,.94);backdrop-filter:blur(14px);border-bottom:1px solid #e6ebf2;position:sticky;top:0;z-index:50}
.nav-wrap{height:100%;display:flex;align-items:center;gap:30px}
.brand{display:flex;align-items:center;gap:10px;line-height:1.1}
.brand-mark{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#2459d6,#477df0);color:#fff;display:grid;place-items:center;font-weight:900;box-shadow:0 8px 22px rgba(37,89,214,.2)}
.brand strong{display:block;font-size:17px}
.brand small{display:block;color:#7d8798;font-size:10px;margin-top:3px}
.nav-links{display:flex;gap:27px;margin-left:auto}
.nav-links a{font-size:13px;font-weight:650;color:#596579;transition:.2s}
.nav-links a:hover
.nav-button{background:#245bd7;color:white;padding:10px 17px;border-radius:10px;font-size:12px;font-weight:750;box-shadow:0 7px 18px rgba(36,91,215,.18)}

.hero{position:relative;overflow:hidden;padding:82px 0 86px;background:linear-gradient(135deg,#edf4ff 0%,#f8fbff 55%,#eef9f5 100%)}
.hero:before{content:"";position:absolute;width:520px;height:520px;border-radius:50%;right:-220px;top:-250px;background:rgba(59,105,225,.08)}
.hero-grid{position:relative;display:grid;grid-template-columns:1.08fr .72fr;gap:70px;align-items:center}
.eyebrow,.section-label{font-size:10px;letter-spacing:1.7px;font-weight:850;color:#285bd2}
.hero h1{font-size:clamp(40px,5vw,62px);line-height:1.08;letter-spacing:-2.5px;margin-top:15px;max-width:700px}
.hero h1 em{font-style:normal;color:#245bd7}
.hero-text{font-size:16px;color:#667286;max-width:610px;margin:22px 0 27px}
.hero-actions{display:flex;gap:12px}
.primary-btn,.secondary-btn{padding:13px 20px;border-radius:11px;font-size:13px;font-weight:750}
.primary-btn{background:#245bd7;color:white;box-shadow:0 10px 24px rgba(36,91,215,.2)}
.secondary-btn{background:white;border:1px solid #dfe5ee;color:#3c485b}
.trust-row{display:flex;flex-wrap:wrap;gap:20px;margin-top:26px;color:#6d788a;font-size:11px}
.trust-row span:first-child

.hero-card{background:white;border:1px solid #e1e7ef;border-radius:20px;padding:25px;box-shadow:0 25px 65px rgba(31,48,78,.11);transform:rotate(1deg)}
.hero-card-top{font-size:12px;color:#68758a;font-weight:700;display:flex;align-items:center;gap:9px}
.status-dot{width:8px;height:8px;background:#28ad78;border-radius:50%;box-shadow:0 0 0 4px #e1f7ed}
.hero-card h2{font-size:24px;line-height:1.25;letter-spacing:-.7px;margin:25px 0 12px}
.study-item{display:flex;gap:13px;align-items:center;padding:15px 0;border-top:1px solid #edf0f5}
.study-item>span{width:31px;height:31px;border-radius:8px;background:#eef3ff;color:#285bd1;display:grid;place-items:center;font-size:10px;font-weight:850}
.study-item strong,.study-item small{display:block}
.study-item strong{font-size:13px}
.study-item small{font-size:10px;color:#8993a4;margin-top:2px}

.quick-strip{background:white;border-bottom:1px solid #e7ebf1}
.quick-grid{display:grid;grid-template-columns:repeat(4,1fr)}
.quick-grid a{padding:20px 18px;border-right:1px solid #edf0f4;transition:.2s}
.quick-grid a:first-child
.quick-grid a:hover
.quick-grid strong,.quick-grid small{display:block}
.quick-grid strong{font-size:12px}
.quick-grid small{font-size:10px;color:#8993a4;margin-top:2px}

.section{padding:78px 0}
.light-section{background:#fff}
.section-heading{margin-bottom:30px}
.section-heading h2,.center-heading h2,.about-card h2{font-size:30px;line-height:1.2;letter-spacing:-1px;margin-top:7px}
.section-heading p,.center-heading p{font-size:13px;color:#778397;margin-top:6px}

.subject-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.subject-card{position:relative;background:white;border:1px solid #e2e8ef;border-radius:15px;padding:21px;min-height:170px;transition:.22s}
.subject-card:hover,.content-card:hover{transform:translateY(-4px);box-shadow:0 16px 35px rgba(31,49,82,.08);border-color:#d4ddea}
.subject-icon{font-size:25px;display:block;margin-bottom:13px}
.subject-card strong{display:block;font-size:15px}
.subject-card small{display:block;color:#7f8a9c;font-size:10px;line-height:1.5;margin-top:4px;padding-right:10px}
.subject-card b{position:absolute;left:21px;bottom:17px;color:#285bd2;font-size:11px}

.content-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}
.content-card{background:#f9fbfd;border:1px solid #e3e8ef;border-radius:15px;padding:24px;min-height:230px;transition:.22s}
.content-tag{display:inline-block;background:#edf3ff;color:#285bd2;padding:4px 8px;border-radius:6px;font-size:8px;font-weight:850;letter-spacing:.7px}
.content-tag.green{background:#eaf8f2;color:#18835c}
.content-tag.purple{background:#f2edff;color:#7250c7}
.content-card h3{font-size:18px;line-height:1.3;margin:17px 0 8px}
.content-card p{font-size:12px;color:#778296;line-height:1.7}
.content-card a{display:inline-block;color:#285bd2;font-size:11px;font-weight:750;margin-top:20px}

.quiz-banner{border-radius:19px;padding:38px 42px;background:linear-gradient(135deg,#1c3260,#244d9a);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:30px;box-shadow:0 20px 45px rgba(29,53,102,.15)}
.quiz-label{font-size:9px;letter-spacing:1.5px;color:#9fbaff;font-weight:850}
.quiz-banner h2{font-size:28px;line-height:1.2;margin:8px 0}
.quiz-banner p{font-size:12px;color:#c4d0e4;max-width:620px}
.quiz-banner>a{white-space:nowrap;background:white;color:#2453a9;padding:12px 18px;border-radius:10px;font-size:12px;font-weight:800}

.guide-section{padding:80px 0;background:#14233d;color:white}
.guide-grid{display:grid;grid-template-columns:.9fr 1fr;gap:90px;align-items:center}
.light-label{color:#91afff}
.guide-grid h2{font-size:35px;line-height:1.2;letter-spacing:-1px;margin:9px 0 18px}
.guide-grid>div>p{color:#aebacd;font-size:13px;max-width:520px}
.guide-list{border-left:1px solid #35445d}
.guide-list>div{display:flex;gap:20px;padding:18px 0 18px 28px;border-bottom:1px solid #2c3b55}
.guide-list>div:last-child
.guide-list>div>span{color:#83a6ff;font-size:11px;font-weight:850}
.guide-list strong{font-size:14px}
.guide-list p{font-size:11px;color:#9eabbd;margin-top:2px}

.about-section{background:#f7f9fc}
.about-card{background:white;border:1px solid #e1e7ef;border-radius:18px;padding:36px;display:grid;grid-template-columns:.85fr 1.15fr;gap:55px;align-items:center}
.about-card p{font-size:13px;color:#707c8e;line-height:1.8}

.footer{background:#0d1729;color:#9ca8ba;padding:52px 0 20px}
.footer-grid{display:grid;grid-template-columns:1.5fr .7fr .8fr;gap:65px;padding-bottom:40px}
.footer-brand{color:white;margin-bottom:14px}
.footer p{font-size:11px;max-width:320px}
.footer h4{color:white;font-size:12px;margin-bottom:13px}
.footer-grid>div>a:not(.brand){display:block;font-size:11px;margin:7px 0;color:#9ca8ba}
.footer-bottom{border-top:1px solid #253249;padding-top:17px;display:flex;justify-content:space-between;font-size:9px;color:#738095}

@media(max-width:900px){
.nav-links{display:none}
.nav-wrap{gap:12px}
.nav-button{margin-left:auto}
.hero-grid,.guide-grid,.about-card{grid-template-columns:1fr;gap:40px}
.hero-card{max-width:560px;width:100%;margin:auto}
.subject-grid{grid-template-columns:repeat(2,1fr)}
}

@media(max-width:620px){
.container{width:calc(100% - 26px)}
.site-header{height:67px}
.brand-mark{width:37px;height:37px}
.brand strong{font-size:15px}
.brand small{font-size:9px}
.nav-button{padding:9px 11px;font-size:10px}
.hero{padding:60px 0}
.hero h1{font-size:39px;letter-spacing:-1.8px}
.hero-text{font-size:14px}
.hero-actions{flex-direction:column}
.hero-actions a{text-align:center}
.trust-row{gap:10px}
.quick-grid{grid-template-columns:1fr 1fr}
.quick-grid a{padding:15px 9px}
.quick-grid strong{font-size:10px}
.quick-grid small{font-size:9px}
.section{padding:58px 0}
.section-heading h2,.center-heading h2,.about-card h2{font-size:27px}
.subject-grid,.content-grid{grid-template-columns:1fr}
.quiz-banner{padding:27px 23px;display:block}
.quiz-banner h2{font-size:24px}
.quiz-banner>a{display:inline-block;margin-top:20px}
.guide-grid h2{font-size:29px}
.about-card{padding:25px}
.footer-grid{grid-template-columns:1fr;gap:30px}
.footer-bottom{display:block}
.footer-bottom span{display:block;margin-top:6px}
}
